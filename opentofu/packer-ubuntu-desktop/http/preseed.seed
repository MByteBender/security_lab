# Localization (This should stop the "Choose Language" screen)
d-i debian-installer/locale string en_US
d-i localechooser/preferred-locale string en_US.UTF-8
d-i localechooser/supported-locales multiselect en_US.UTF-8
d-i console-setup/ask_detect boolean false
d-i console-setup/layoutcode string us
d-i keyboard-configuration/layoutcode string us

# If it asks about a firmware/driver, just skip it
d-i hw-detect/load_flash_firmware boolean false

# Networking
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string ubuntu-desktop
d-i netcfg/get_domain string unassigned-domain
d-i netcfg/wireless_wep string

# Localization (also moved to preseed)
d-i debian-installer/locale string en_US
d-i console-setup/layoutcode string us

# Account Setup
d-i passwd/user-fullname string ubuntu
d-i passwd/username string ubuntu
d-i passwd/user-password password ubuntu
d-i passwd/user-password-again password ubuntu
d-i user-setup/allow-password-weak boolean true
d-i user-setup/encrypt-home boolean false

# Partitioning
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

# Package Selection
tasksel tasksel/first multiselect ubuntu-desktop
d-i pkgsel/include string openssh-server
d-i pkgsel/upgrade select none

# Late Command: Force SSH to start and allow password login
# Late Command: Mount the second ISO and install SSH packages offline
d-i preseed/late_command string \
    mkdir -p /mnt/iso; \
    mount /dev/sr1 /mnt/iso; \
    in-target dpkg -i /mnt/iso/openssh-client_5.3p1-3ubuntu3_i386.deb; \
    in-target dpkg -i /mnt/iso/openssh-sftp-server_5.3p1-3ubuntu3_i386.deb; \
    in-target dpkg -i /mnt/iso/openssh-server_5.3p1-3ubuntu3_i386.deb; \
    in-target sed -i 's/PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config; \
    in-target update-rc.d ssh defaults; \
    umount /mnt/iso

# Bootloader
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean true

# Finish
d-i finish-install/reboot_in_progress note