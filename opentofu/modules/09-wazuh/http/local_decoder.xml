<decoder name="sophos_fw">
  <prematch>device_name="SFW"</prematch>
</decoder>

<!-- Extrahiert die Quell-IP -->
<decoder name="sophos_fw">
  <parent>sophos_fw</parent>
  <regex>src_ip="(\d+.\d+.\d+.\d+)"</regex>
  <order>srcip</order>
</decoder>

<!-- Extrahiert die Ziel-IP -->
<decoder name="sophos_fw">
  <parent>sophos_fw</parent>
  <regex>dst_ip="(\d+.\d+.\d+.\d+)"</regex>
  <order>dstip</order>
</decoder>

<!-- Extrahiert den Ziel-Port -->
<decoder name="sophos_fw">
  <parent>sophos_fw</parent>
  <regex>dst_port=(\d+)</regex>
  <order>dstport</order>
</decoder>

<!-- Extrahiert die Komponente (z.B. IP Spoof) -->
<decoder name="sophos_fw">
  <parent>sophos_fw</parent>
  <regex>log_component="(\w+\s*\w*)"</regex>
  <order>log_component</order>
</decoder>