# Localization
d-i debian-installer/locale string en_US
d-i console-setup/ask_detect boolean false
d-i keyboard-configuration/xkb-keymap select us

# Network configuration
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string kali
d-i netcfg/get_domain string local
d-i netcfg/hostname string kali

# Mirror settings (using Kali's official rolling repo)
d-i mirror/country string manual
d-i mirror/http/hostname string http.kali.org
d-i mirror/http/directory string /kali
d-i mirror/http/proxy string

# User accounts
# Note: In newer Kali versions, 'root' is disabled by default. 
# We create a 'kali' user with sudo privileges.
d-i passwd/user-fullname string kali
d-i passwd/username string kali
d-i passwd/user-password password kali
d-i passwd/user-password-again password kali
d-i user-setup/allow-password-weak boolean true
d-i user-setup/encrypt-home boolean false

# Clock and time zone
d-i clock-setup/utc boolean true
d-i time/zone string US/Eastern
d-i clock-setup/ntp boolean true

d-i partman-auto/method string lvm
d-i partman-auto/choose_recipe select atomic
d-i partman-partitioning/default_label string msdos
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true


# Package selection
# 'standard' and 'kali-linux-default' are usually what you want
tasksel tasksel/first multiselect standard, kali-desktop-xfce, kali-linux-default
d-i pkgsel/include string openssh-server, vim, wget, curl
d-i pkgsel/upgrade select full-upgrade

# Boot loader installation
d-i grub-installer/skip boolean true
#d-i grub-installer/only_debian boolean true
#d-i grub-installer/with_other_os boolean true
#d-i grub-installer/bootdev string /dev/sda



# This is the "magic" string that fixes 99% of Proxmox failures:
#d-i grub-installer/bootdev string default

# If 'default' fails, replace it with:
# d-i grub-installer/bootdev string /dev/sda
# (Use /dev/vda if using VirtIO, or /dev/sda if using SCSI/SATA)

d-i preseed/late_command string \
in-target apt-get install -y grub-pc; \
in-target grub-install /dev/sda; \
in-target update-grub

# Finishing up the installation
d-i finish-install/reboot_in_progress note
