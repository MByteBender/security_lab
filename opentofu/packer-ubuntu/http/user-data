#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  # Identity handles the user creation in 24.04/25.10
  identity:
    hostname: ubuntu-server
    username: ubuntu
    password: testing
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: direct
  late-commands:
    - curtin in-target -- target/usr/bin/apt-get update
    - curtin in-target -- target/usr/bin/apt-get install -y openssh-server
    - curtin in-target -- systemctl enable ssh